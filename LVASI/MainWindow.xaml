<Window x:Class="LVASI.MainWindow"
        x:Name="ThisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LVASI.ViewModels"
        xmlns:models="clr-namespace:LVASI.Models"
        xmlns:conv="clr-namespace:LVASI.Converters"
        mc:Ignorable="d"
         Title="LVASI"
         Height="860" Width="1100" MinWidth="1000" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="ContentBg" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="Accent" Color="#0078D4"/>
        <SolidColorBrush x:Key="AccentDark" Color="#005A9E"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#666666"/>
        <SolidColorBrush x:Key="Warning" Color="#FF8C00"/>
        <SolidColorBrush x:Key="Success" Color="#107C10"/>
        <SolidColorBrush x:Key="TabBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TabSelectedBg" Color="#3E3E42"/>
        <SolidColorBrush x:Key="TabHoverBg" Color="#38383D"/>
        <SolidColorBrush x:Key="TabText" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="Divider" Color="#E8E8E8"/>

        <conv:TileColorConverter x:Key="TileColorConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <conv:BoolToVisConverter x:Key="BoolToVisConverter"/>
        <conv:NullToVisConverter x:Key="NullToVisConverter"/>
        <conv:LogoUrlConverter x:Key="LogoUrlConverter"/>

        <Style x:Key="TabHeaderStyle" TargetType="TabItem">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TabText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderThickness="0" Padding="0">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <Rectangle x:Name="SelectionDot" Height="3" Fill="{StaticResource Accent}"
                                           VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                           Margin="4,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ContentBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource TabHoverBg}"/>
                            </MultiTrigger>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter TargetName="SelectionDot" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <ScrollViewer x:Name="TabScroller"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PanningMode="VerticalOnly"
                                              Background="{StaticResource SidebarBg}"
                                              BorderThickness="0">
                                    <TabPanel IsItemsHost="True" Margin="0"/>
                                </ScrollViewer>
                                <Border x:Name="ArrowUp" Height="20" VerticalAlignment="Top"
                                        Background="#CCF0F0F0" IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                    <TextBlock Text="▲" FontSize="12"
                                               Foreground="#666"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="ArrowDown" Height="20" VerticalAlignment="Bottom"
                                        Background="#CCF0F0F0" IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                    <TextBlock Text="▼" FontSize="12"
                                               Foreground="#666"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsIndeterminate" Value="False"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TabText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#004578"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.25"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource Warning}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E67E00"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#CC6F00"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.25"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TileView">
            <Border Width="112" Height="124" Margin="5"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="ToolTip" Value="{Binding ToolTipContent}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToolTipContent}" Value="{x:Null}">
                                <Setter Property="ToolTip" Value="{x:Null}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Disabled}" Value="True">
                                <Setter Property="Cursor" Value="No"/>
                                <Setter Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Color="#888"/>
                </Border.Effect>
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.ToggleItemSelectionCommand, Source={x:Reference ThisWindow}}"
                                   CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Selected indicator bar -->
                    <Border Grid.Row="0" Height="3" CornerRadius="8,8,0,0"
                            Background="{StaticResource Accent}"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}"/>
                    <!-- Selection border highlight -->
                    <Border Grid.RowSpan="3" BorderBrush="{StaticResource Accent}" BorderThickness="2"
                            CornerRadius="8"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}"/>
                    <!-- Logo area -->
                    <Border Grid.Row="1" CornerRadius="6" Margin="6"
                            Background="{StaticResource CardBg}">
                        <Grid>
                            <!-- Colored initials fallback (hidden when logo exists) -->
                            <Border Background="{Binding Id, Converter={StaticResource TileColorConverter}}"
                                    CornerRadius="6"
                                    Visibility="{Binding LogoUrl, Converter={StaticResource NullToVisConverter}, ConverterParameter=invert}">
                                <TextBlock Text="{Binding Initials}" FontSize="28" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <!-- Logo -->
                            <Image Source="{Binding LogoUrl, Converter={StaticResource LogoUrlConverter}}"
                                   Stretch="Uniform" Margin="4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- Capability badge overlay (top-right) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="2" CornerRadius="8" Padding="5,2"
                                    Visibility="{Binding CapabilityIcon, Converter={StaticResource NullToVisConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#0078D4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStore}" Value="True">
                                                <Setter Property="Background" Value="#FF8C00"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Disabled}" Value="True">
                                                <Setter Property="Background" Value="#888"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="⬇"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStore}" Value="True">
                                                    <Setter Property="Text" Value="S"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Disabled}" Value="True">
                                                    <Setter Property="Text" Value="!"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Name -->
                    <TextBlock Grid.Row="2" Text="{Binding Name}" FontSize="10.5"
                               Foreground="{StaticResource TextPrimary}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               MaxHeight="26" LineHeight="12"
                               Margin="4,0,4,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Disabled}" Value="True">
                                        <Setter Property="Foreground" Value="#999"/>
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ListView">
            <CheckBox IsChecked="{Binding IsSelected}" Margin="6,3,0,3" FontSize="14"
                      VerticalAlignment="Center" HorizontalAlignment="Left"
                      IsEnabled="{Binding Disabled, Converter={StaticResource InverseBoolConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Name}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Disabled}" Value="True">
                                        <Setter Property="Foreground" Value="#888"/>
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border CornerRadius="8" Padding="6,2" Margin="6,0,0,0"
                            Visibility="{Binding CapabilityIcon, Converter={StaticResource NullToVisConverter}}"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#0078D4"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStore}" Value="True">
                                        <Setter Property="Background" Value="#FF8C00"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Disabled}" Value="True">
                                        <Setter Property="Background" Value="#888"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="⬇"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStore}" Value="True">
                                            <Setter Property="Text" Value="S"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Disabled}" Value="True">
                                            <Setter Property="Text" Value="!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToolTipContent}" Value="{x:Null}">
                                <Setter Property="ToolTip" Value="{x:Null}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ToolTipContent, Converter={StaticResource NullToVisConverter}}" Value="Visible">
                                <Setter Property="ToolTip" Value="{Binding ToolTipContent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource ContentBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- ===== TAB CONTROL (spans left sidebar + content) ===== -->
        <TabControl Grid.Column="0" Grid.ColumnSpan="2"
                    ItemsSource="{Binding Categories}"
                    SelectedIndex="0"
                    TabStripPlacement="Left"
                    BorderThickness="0"
                    Background="Transparent"
                    ItemContainerStyle="{StaticResource TabHeaderStyle}"
                    Style="{StaticResource TabControlStyle}"
                    Loaded="OnTabControlLoaded">
            <TabControl.ItemTemplate>
                <DataTemplate DataType="models:SoftwareCategory">
                    <Grid Width="28" Height="28">
                        <Image Source="{Binding IconPath}" Width="28" Height="28"
                               ToolTip="{Binding Name}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Icon}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IconPath, Converter={StaticResource NullToVisConverter}, ConverterParameter=invert}"/>
                    </Grid>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="models:SoftwareCategory">
                    <Border Background="{StaticResource ContentBg}" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Category header bar -->
                            <Border Grid.Row="0" Background="{StaticResource CardBg}"
                                    CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="28" Height="28" Margin="0,0,6,0">
                                            <Image Source="{Binding IconPath}" Width="28" Height="28"/>
                                            <TextBlock Text="{Binding Icon}" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IconPath, Converter={StaticResource NullToVisConverter}, ConverterParameter=invert}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Items.Count, StringFormat=' ({0})'}"
                                                   FontSize="13" Foreground="{StaticResource TextSecondary}"
                                                   Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" Margin="0,0,4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Liste"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsTileView, Source={x:Reference ThisWindow}}" Value="True">
                                                            <Setter Property="Text" Value="Tuiles"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ToggleButton x:Name="ViewToggle"
                                                      Width="32" Height="28"
                                                      IsChecked="{Binding DataContext.IsTileView, Source={x:Reference ThisWindow}}"
                                                      ToolTip="Basculer en mode tuiles"
                                                      Cursor="Hand"
                                                      Background="{StaticResource CardBorder}"
                                                      BorderThickness="1" BorderBrush="{StaticResource CardBorder}">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Content" Value="☰"/>
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="⊞"/>
                                                            <Setter Property="Background" Value="{StaticResource Accent}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Items area -->
                            <Border Grid.Row="1" Background="{StaticResource CardBg}"
                                    CornerRadius="6" Padding="6"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                               VerticalScrollBarVisibility="Auto"
                                               PanningMode="VerticalOnly"
                                               MouseRightButtonDown="OnItemsRightClick">
                                    <Grid>
                                        <!-- List view -->
                                        <ItemsControl ItemsSource="{Binding Items}"
                                                       Visibility="{Binding DataContext.IsTileView, Source={x:Reference ThisWindow}, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"
                                                      ItemTemplate="{StaticResource ListView}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" Margin="4,0,0,0"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <!-- Tile view -->
                                        <ItemsControl ItemsSource="{Binding Items}"
                                                       Visibility="{Binding DataContext.IsTileView, Source={x:Reference ThisWindow}, Converter={StaticResource BoolToVisConverter}}"
                                                      ItemTemplate="{StaticResource TileView}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- ===== RIGHT SIDEBAR ===== -->
        <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource SidebarBg}" Padding="8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Selection card -->
                <Border Grid.Row="0" Background="#2A2A2E" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                        BorderBrush="{StaticResource Warning}" BorderThickness="0,0,0,2">
                    <StackPanel>
                        <TextBlock Text="{Binding L.Selection}" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource Warning}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedCountText}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource Warning}"/>
                            <TextBlock Text="{Binding TotalSoftwareCount, StringFormat=' / {0}'}"
                                       FontSize="16" Foreground="#CCC"
                                       Margin="4,6,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding L.Selected}" FontSize="11"
                                   Foreground="#999" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Quick actions -->
                <Border Grid.Row="1" Background="{StaticResource TabSelectedBg}" CornerRadius="6" Padding="0" Margin="0,0,0,8"
                        BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,2">
                    <StackPanel Margin="8">
                        <Button Command="{Binding SelectEssentialsCommand}"
                                Content="{Binding L.SelectEssentials}" Style="{StaticResource AccentBtn}" Margin="0,0,0,2"/>
                        <Button Command="{Binding DeselectAllCommand}"
                                Content="{Binding L.DeselectAll}" Style="{StaticResource ActionBtn}" Margin="0,0,0,2"/>
                        <Button Command="{Binding ShowSelectionCommand}"
                                Content="{Binding L.ShowSelection}" Style="{StaticResource ActionBtn}"/>
                    </StackPanel>
                </Border>

                <!-- Action buttons -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent" BorderThickness="0">
                    <StackPanel>

                        <Grid>
                            <!-- EN LIGNE + HORS LIGNE: visible when idle -->
                            <StackPanel Visibility="{Binding IsOperationRunning, Converter={StaticResource InverseBoolConverter}}">
                                <Border Background="{StaticResource TabSelectedBg}" CornerRadius="6"
                                        Padding="8" Margin="0,0,0,6"
                                        BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,2">
                                    <StackPanel>
                                    <TextBlock Text="{Binding L.Online}" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
                                        <Button Command="{Binding InstallCommand}"
                                                IsEnabled="{Binding IsInstallEnabled}"
                                                Content="{Binding L.Install}" Style="{StaticResource AccentBtn}" Margin="0,0,0,4"
                                                ToolTip="Installe les logiciels sélectionnés"/>
                                        <Button Command="{Binding DownloadCommand}"
                                                IsEnabled="{Binding IsDownloadEnabled}"
                                                Content="{Binding L.Download}" Style="{StaticResource WarningBtn}" Margin="0,0,0,2"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource TabSelectedBg}" CornerRadius="6"
                                        Padding="8" Margin="0,0,0,8"
                                        BorderBrush="{StaticResource Warning}" BorderThickness="0,0,0,2">
                                    <StackPanel>
                                    <TextBlock Text="{Binding L.Offline}" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Warning}" Margin="0,0,0,4"/>
                                        <Button Command="{Binding OfflineInstallCommand}"
                                                IsEnabled="{Binding IsOfflineInstallEnabled}"
                                                Content="{Binding L.OfflineInstall}" Style="{StaticResource WarningBtn}" Margin="0,0,0,2"/>
                                        <Button Command="{Binding CheckOfflineCommand}"
                                                Content="{Binding L.CheckOffline}" Style="{StaticResource ActionBtn}" Margin="0,0,0,2"/>
                                        <Button Command="{Binding OpenDownloadFolderCommand}"
                                                Content="{Binding L.OpenDownloadFolder}" Style="{StaticResource ActionBtn}" Margin="0,0,0,2"/>
                                        <TextBlock FontSize="11" Foreground="#AAA"
                                                   Visibility="{Binding IsOfflineInstallEnabled, Converter={StaticResource BoolToVisConverter}}"
                                                   Margin="0,2,0,0">
                                            <Run Text="{Binding OfflineFileCount}"/>
                                            <Run Text="{Binding OfflineFileCount}"/> <Run Text="{Binding L.FilesFound, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Summary: visible during operations -->
                            <Border MinHeight="190"
                                    Visibility="{Binding IsOperationRunning, Converter={StaticResource BoolToVisConverter}}"
                                    Background="#1A1A1E" CornerRadius="6" Padding="8"
                                    BorderBrush="#4CAF50" BorderThickness="0,0,0,2">
                                <StackPanel>
                                <TextBlock Text="{Binding L.Operations}" FontSize="10" FontWeight="Bold"
                                           Foreground="#4CAF50" Margin="0,0,0,4"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300"
                                                  Background="Transparent" BorderThickness="0">
                                        <ItemsControl ItemsSource="{Binding OperationItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                                   FontSize="13" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#888"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="Processing">
                                                                            <Setter Property="Foreground" Value="#FF8C00"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Success">
                                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                            <Setter Property="Foreground" Value="#E53935"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" Text="{Binding SoftwareName}"
                                                                   FontSize="12" Foreground="#CCC"
                                                                   VerticalAlignment="Center" Margin="4,0,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource TabSelectedBg}" CornerRadius="6"
                                Padding="8" Margin="0,0,0,8"
                                BorderBrush="#9B59B6" BorderThickness="0,0,0,2">
                            <StackPanel>
                                <TextBlock Text="{Binding L.Options}" FontSize="10" FontWeight="Bold"
                                           Foreground="#9B59B6" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ComboBox ItemsSource="{Binding Languages}"
                                              SelectedItem="{Binding SelectedLanguage}"
                                              Width="140" Height="28"
                                              FontSize="12"
                                              Foreground="#AAA"
                                              Background="#2A2A2E"
                                              BorderBrush="#555"
                                              BorderThickness="1"
                                              Cursor="Hand">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding FlagPath}" Width="24" Height="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding HiddenMode}" Foreground="#AAA"
                                          FontSize="12" Content="{Binding L.HiddenMode}" Margin="0,0,0,4"/>
                                <Button Command="{Binding OpenLogCommand}"
                                        Content="{Binding L.OpenLog}" Style="{StaticResource ActionBtn}"
                                        ToolTip="Affiche le journal des opérations"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource TabSelectedBg}" CornerRadius="6"
                                Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding L.Version}" FontSize="10" FontWeight="Bold"
                                           Foreground="#888" Margin="0,0,0,4"/>
                                <TextBlock FontSize="13" Foreground="#AAA">
                                    <Run Text="{Binding Version, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding UpdateAvailableText}"
                                    FontSize="11" Foreground="{StaticResource Warning}"
                                    FontWeight="Bold"
                                    Visibility="{Binding LatestVersion, Converter={StaticResource NullToVisConverter}}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource TabSelectedBg}" CornerRadius="6"
                                Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                            <TextBlock Text="{Binding L.Contact}" FontSize="10" FontWeight="Bold"
                                       Foreground="#7FBFFF" Margin="0,0,0,4"/>
                                <TextBlock FontSize="12" Foreground="#AAA" Margin="0,0,0,2">
                                    <Hyperlink NavigateUri="https://github.com/SebastienFRA/LVASI"
                                               RequestNavigate="Hyperlink_RequestNavigate"
                                               Foreground="#7FBFFF">github.com/SebastienFRA/LVASI</Hyperlink>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="#AAA">
                                    <Hyperlink NavigateUri="mailto:sebastien.lvasi@gmail.com"
                                               RequestNavigate="Hyperlink_RequestNavigate"
                                               Foreground="#7FBFFF">sebastien.lvasi@gmail.com</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== INFO BAND ===== -->
        <Border x:Name="InfoBand" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                Background="White" Padding="12,8" Visibility="Collapsed"
                BorderThickness="0,1,0,0" BorderBrush="#DDD">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="InfoBandTitle" Grid.Column="0"
                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                           VerticalAlignment="Top" Margin="0,0,12,0"
                           MinWidth="120" MaxWidth="250"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="InfoBandDesc" Grid.Column="1"
                           FontSize="13" Foreground="#333"
                           VerticalAlignment="Top" TextWrapping="Wrap"
                           Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="✕" Width="22" Height="22"
                        FontSize="12" FontWeight="Bold"
                        Background="#EEE" Foreground="#666"
                        BorderThickness="1" BorderBrush="#CCC"
                        Cursor="Hand" VerticalAlignment="Top"
                        Click="CloseInfoBand_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="2" Padding="4,0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#555"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ===== BOTTOM BAR ===== -->
        <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2"
                Background="{StaticResource SidebarBg}" BorderThickness="0,1,0,0"
                BorderBrush="#222">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Action}"
                           Foreground="#AAA" FontSize="12"
                           VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Margin="8,0"
                              Style="{StaticResource ModernProgressBar}"
                              Minimum="0" Maximum="{Binding ProgressMax}"
                              Value="{Binding ProgressValue}"
                              IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                <TextBlock Grid.Column="2" Text="{Binding DownloadSizeText}"
                           FontSize="11" Foreground="#888" VerticalAlignment="Center"
                           Margin="8,0" MinWidth="100"/>
                <TextBlock Grid.Column="3" Text="{Binding DownloadSpeed}"
                           FontSize="11" Foreground="#888" VerticalAlignment="Center"
                           Margin="8,0" MinWidth="60"/>
                <TextBlock Grid.Column="4" Text="{Binding ProgressCounter}"
                           FontSize="11" Foreground="#666" VerticalAlignment="Center"
                           MinWidth="40" TextAlignment="Right" Margin="8,0,4,0"/>
                <Button Grid.Column="5" Content="✕"
                        Command="{Binding StopCommand}"
                        Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibilityConverter}}"
                        FontSize="10" FontWeight="Bold"
                        Background="#C0392B" Foreground="White"
                        BorderThickness="0" Padding="8,2"
                        Cursor="Hand" Margin="0,0,0,0"
                        ToolTip="Stop all operations"/>
            </Grid>
        </Border>
    </Grid>
</Window>
