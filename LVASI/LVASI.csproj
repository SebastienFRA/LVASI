<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>global.ico</ApplicationIcon>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="BootstrapperNet48\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\software.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Logos\**" />
    <EmbeddedResource Include="CategoryIcons\**" />
    <EmbeddedResource Include="Lang\**" />
    <EmbeddedResource Include="Flags\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>



</Project>
